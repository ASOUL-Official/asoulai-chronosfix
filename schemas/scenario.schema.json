{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ASOUL-Official/asoulai-chronosfix/schemas/scenario.schema.json",
  "title": "ChronosFix Incident Scenario",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "incident_id",
    "title",
    "baseline",
    "events",
    "hypotheses",
    "ground_truth"
  ],
  "properties": {
    "incident_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "ground_truth": {
      "type": "object",
      "properties": {
        "case_type": {"enum": ["golden", "badcase", "insufficient-evidence"]},
        "model_support": {"enum": ["supported", "unsupported"]},
        "expected_primary_causes": {"type": "array", "items": {"type": "string"}},
        "expected_amplifiers": {"type": "array", "items": {"type": "string"}},
        "expected_not_causal": {"type": "array", "items": {"type": "string"}},
        "expected_non_causes": {"type": "array", "items": {"type": "string"}},
        "expected_outcome": {"enum": ["diagnose", "abstain"]},
        "fixture_scope": {"enum": ["pipeline-and-evaluation", "evaluation-only-counterfactual"]},
        "known_actual_causes": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "string"},
        "boundary_note": {"type": "string"}
      },
      "required": ["case_type", "model_support", "expected_primary_causes", "expected_outcome", "fixture_scope"]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traffic_rps", "pool_size", "dependency_latency_factor", "code_version"],
      "properties": {
        "traffic_rps": {"type": "number", "exclusiveMinimum": 0},
        "pool_size": {"type": "integer", "minimum": 1},
        "dependency_latency_factor": {"type": "number", "exclusiveMinimum": 0},
        "code_version": {"type": "string", "minLength": 1},
        "adaptive_min_pool": {"type": "boolean"},
        "code_latency_factor": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "events": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "owner", "intervention", "rationale"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "intervention": {"type": "object"},
          "rationale": {"type": "string"}
        }
      }
    },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "changes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "changes": {"type": "object"},
          "mandatory": {"type": "boolean"}
        }
      }
    },
    "patch_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "changes", "risk", "cost", "rollback", "rollback_changes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "changes": {"type": "object"},
          "risk": {"type": "number", "minimum": 0, "maximum": 1},
          "cost": {"type": "number", "minimum": 0, "maximum": 1},
          "rollback": {"type": "string", "minLength": 1},
          "rollback_changes": {"type": "object", "minProperties": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ground_truth": {
            "properties": {"fixture_scope": {"const": "pipeline-and-evaluation"}},
            "required": ["fixture_scope"]
          }
        }
      },
      "then": {
        "required": ["mutations", "patch_candidates"]
      }
    },
    {
      "if": {
        "properties": {
          "ground_truth": {
            "properties": {"fixture_scope": {"const": "evaluation-only-counterfactual"}},
            "required": ["fixture_scope"]
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["mutations"]},
            {"required": ["patch_candidates"]}
          ]
        }
      }
    }
  ]
}
